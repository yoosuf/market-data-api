# Copy to .env and fill in, or export these in your shell.
# .env is git-ignored.

ADDR=:8080
DB_PATH=./market.db

# Set to false to remove the /admin/providers routes entirely.
# They are UNAUTHENTICATED and return API keys in full: keep the port private.
PROVIDER_ADMIN_API=true

# Used by cmd/refresh only.
REFRESH_SYMBOLS=IBM,AAPL,MSFT
REFRESH_TIMEOUT_SECONDS=120

# Upstream endpoints and API keys are NOT configured here. They are rows in
# the providers table, managed via POST /admin/providers. See docs/PROVIDERS.md.
